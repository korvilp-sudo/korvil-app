name: Deploy KAI-KBD

on:
  push:
    paths:
      - 'kai-core/kai-kbd/deploy/kai-kbd.zip' # <- caminho completo a partir da raiz

permissions:
  contents: write

jobs:
  unzip:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Descompactar
        run: |
          unzip -o kai-core/kai-kbd/deploy/kai-kbd.zip -d kai-core/kai-kbd/ # <- descompacta aqui
          rm kai-core/kai-kbd/deploy/kai-kbd.zip

      - name: Commit
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add kai-core/kai-kbd/
          git commit -m "🤖 Auto Deploy KAI-KBD" || exit 0
          git push
